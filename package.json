{
  "name": "weekend-mwohae",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --local --test-scheduled",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs && node scripts/integration.mjs",
    "format": "prettier --write src shared worker scripts tests docs README.md package.json tsconfig.json vite.config.ts playwright.config.ts wrangler*.jsonc .github index.html",
    "db:migrate": "wrangler d1 migrations apply weekend-mwohae --local",
    "db:seed": "node scripts/seed.mjs",
    "setup": "npm run db:migrate && npm run db:seed",
    "check": "npm run typecheck && npm test && npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "test:ui": "playwright test",
    "deploy": "node scripts/deploy.mjs",
    "deploy:sample": "node scripts/deploy.mjs --sample",
    "db:snapshot": "node scripts/sample-snapshot.mjs",
    "db:seed:remote": "node scripts/seed-remote.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "tourapi:sync": "node scripts/tourapi-sync.mjs",
    "tourapi:detail:once": "node scripts/run-tourapi-detail-once.mjs",
    "discover:everland": "node --import tsx scripts/discover-everland.mjs",
    "source-registry:candidates": "node --import tsx scripts/source-registry-candidates.mjs",
    "audit:everland:readiness": "node --import tsx scripts/audit-everland-readiness.mjs",
    "audit:event-detail-completeness": "node --import tsx scripts/audit-event-detail-completeness.mjs",
    "fact-tags:dry-run": "node --import tsx scripts/fact-tag-dry-run.mjs",
    "fact-tags:snapshot": "node scripts/fact-tag-snapshot.mjs",
    "companion:dry-run": "node scripts/companion-suitability-dry-run.mjs",
    "companion:plan": "node scripts/companion-suitability-operations.mjs plan",
    "fact-tags:apply": "node --import tsx scripts/fact-tag-operations.mjs apply",
    "fact-tags:verify": "node --import tsx scripts/fact-tag-operations.mjs verify",
    "db:real:snapshot": "node scripts/real-snapshot.mjs",
    "dev:real": "npm run build && wrangler dev --local --config wrangler.jsonc --var APP_MODE:production --test-scheduled",
    "test:ui:real": "playwright test --config playwright.real.config.ts",
    "verify:real": "node scripts/verify-real.mjs",
    "municipal:register": "node --import tsx scripts/register-municipal-events.mjs",
    "municipal:discover": "node --import tsx scripts/municipal-discover-run.mjs --dry-run",
    "municipal:review": "node --import tsx scripts/municipal-review.mjs",
    "municipal:apply": "node --import tsx scripts/municipal-apply.mjs",
    "push:vapid:production": "node scripts/setup-web-push-vapid.mjs --production",
    "test:ui:contract": "node scripts/contract-browser.mjs",
    "dev:sample": "npm run build && wrangler dev --local --var APP_MODE:sample --test-scheduled",
    "test:ui:prod": "playwright test --config playwright.production.config.ts",
    "deploy:verified": "node scripts/deploy.mjs --verified",
    "test:ui:ci": "playwright test tests/browser/discovery.spec.ts --config playwright.ci.config.ts",
    "municipal:ai:probe": "node scripts/run-municipal-ai-probe.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20260918.0-alpha",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
